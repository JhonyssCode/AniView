QMainWindow {
    background-color: #0b0c0d;
}

#Sidebar {
    background-color: #000000;
    border-right: 1px solid #23252b;
    min-width: 70px;
}

#NavButton {
    background: transparent;
    color: #a0a0a0;
    border: none;
    padding: 15px;
    font-size: 22px;
}

#NavButton:hover {
    color: #F47521;
}

#AnimeCard {
    background-color: #1a1c21;
    border-radius: 12px;
    border: 1px solid #23252b;
}

#AnimeCard:hover {
    background-color: #23252b;
    border: 1px solid #F47521;
}

#TitleLabel {
    color: white;
    font-size: 13px;
    font-weight: bold;
}

#SearchBar {
    background-color: #1a1c21;
    border: 1px solid #23252b;
    border-radius: 20px;
    padding: 10px 20px;
    color: white;
    font-size: 14px;
}

#SearchBar:focus {
    border: 1px solid #F47521;
}

QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 8px;
}

QScrollBar::handle:vertical {
    background: #32353c;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #F47521;
}
